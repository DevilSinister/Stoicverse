# Copy to .env.local. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required by Stripe webhooks, video delivery and the development
# login bypass below. Never expose with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=

# Development login bypass (browser QA as a seeded creator / moderator / member).
# All three lines must be set, NODE_ENV must be development, and the Supabase
# host must be listed, or the /api/dev/login route answers 404. Leave them
# unset everywhere except a local machine.
# DEV_LOGIN_BYPASS=1
# DEV_LOGIN_SECRET=<at least 16 random characters>
# DEV_LOGIN_ALLOWED_SUPABASE_HOSTS=<your-dev-project-ref>.supabase.co

# Stripe. Checkout cannot start without the secret key and the price id for the
# product being bought, and the webhook that grants access cannot verify a
# request without its signing secret — the route answers 503 rather than
# guessing. The annual price is optional: when it is absent the annual term is
# not offered on /checkout at all, rather than being offered and refused.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MEMBERSHIP_PRICE_ID=
# STRIPE_MEMBERSHIP_ANNUAL_PRICE_ID=
# STRIPE_MENTORSHIP_PRICE_ID=
