# Copy to .env.local. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required by Stripe webhooks, video delivery and the development
# login bypass below. Never expose with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=

# Development login bypass (browser QA as a seeded creator / moderator / member).
# All three lines must be set, NODE_ENV must be development, and the Supabase
# host must be listed, or the /api/dev/login route answers 404. Leave them
# unset everywhere except a local machine.
# DEV_LOGIN_BYPASS=1
# DEV_LOGIN_SECRET=<at least 16 random characters>
# DEV_LOGIN_ALLOWED_SUPABASE_HOSTS=<your-dev-project-ref>.supabase.co
